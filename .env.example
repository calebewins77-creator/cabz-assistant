# Discord bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect registered in the Discord Developer Portal (OAuth2 > Redirects)
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Database (Railway injects this automatically when a Postgres service is linked)
DATABASE_URL=postgresql://user:password@localhost:5432/cabz

# Web/session
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
PUBLIC_URL=http://localhost:3000

# Default text-command prefix (overridable per-guild from the dashboard)
DEFAULT_PREFIX=!

# Fixed per product spec (section 1) — do not change without updating the spec
PROOF_CHANNEL_ID=1554078641984638977
VERIFIED_ROLE_ID=1554350014497558529

# Comma-separated Discord role IDs authorized to approve/reject proofs and run moderation/#codep.
# Configurable per-guild from the dashboard's Bot Settings page after first login.
STAFF_ROLE_IDS=
