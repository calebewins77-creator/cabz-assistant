<%- include('partials/head', { title: 'Your servers' }) %>
<div style="max-width:1000px; margin: 0 auto; padding: 40px 24px;">
  <div class="topbar" style="padding: 0 0 24px;">
    <% if (user.avatar) { %><img class="avatar" src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64" alt="" /><% } %>
    <span style="color: var(--text-dim); font-size: 0.9rem;"><%= user.global_name || user.username %></span>
    <form method="post" action="/auth/logout" style="margin:0;"><button class="btn btn-sm" type="submit">Log out</button></form>
  </div>

  <div class="page-header">
    <div><h1>Your servers</h1><p>Pick a server to manage CABZ Assistant.</p></div>
  </div>

  <% if (guilds.length === 0) { %>
    <div class="empty-state">You don't manage any Discord servers. Log in with an account that has Manage Server permission.</div>
  <% } else { %>
    <div class="guild-grid">
      <% guilds.forEach(function(g) { %>
        <div class="guild-card">
          <div class="name"><%= g.name %></div>
          <span class="badge <%= g.installed ? 'badge-installed' : 'badge-notinstalled' %>"><%= g.installed ? 'Installed' : 'Not installed' %></span>
          <div style="margin-top:16px;">
            <% if (g.installed) { %>
              <a class="btn btn-primary btn-sm" href="/dashboard/<%= g.id %>">Manage</a>
            <% } else { %>
              <a class="btn btn-sm" target="_blank" rel="noopener" href="https://discord.com/oauth2/authorize?client_id=<%= inviteClientId %>&scope=bot%20applications.commands&guild_id=<%= g.id %>&permissions=1099511693814">Add to server</a>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
</body>
</html>
